{
  "manifest_version": 3,
  "name": "SendPilot – Paketmaße einmal eingeben",
  "short_name": "SendPilot",
  "version": "1.0.0",
  "key": "",
  "description": "Maße & Gewicht einmal eintippen: SendPilot öffnet damit Paketda-Preisvergleich, Klick-n-Schick, Packlink, DHL & Co. mit vorausgefüllten Daten.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SendPilot – Maße eingeben",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://www.paketda.de/*",
    "https://www.klick-n-schick.com/*",
    "https://klick-n-schick.com/*",
    "https://www.dhl.de/*",
    "https://www.ebay.de/*",
    "https://api.ebay.com/*",
    "https://auth.ebay.com/*",
    "https://api.sandbox.ebay.com/*",
    "https://auth.sandbox.ebay.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.paketda.de/paket-preis-rechner.php*"
      ],
      "js": [
        "src/paketda.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.klick-n-schick.com/portal/*",
        "https://klick-n-schick.com/portal/*"
      ],
      "js": [
        "src/klick-n-schick.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dhl.de/de/privatkunden/pakete-versenden/*"
      ],
      "js": [
        "src/dhl-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.de/mesh/seller/*",
        "https://www.ebay.de/itm/*"
      ],
      "js": [
        "src/ebay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "SendPilot-Dialog öffnen"
    }
  }
}
